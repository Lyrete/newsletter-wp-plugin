{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "newsletter-wp-plugin/newsletter",
	"title": "Newsletter",
	"category": "widgets",
	"icon": "email-alt",
	"description": "Display a published newsletter issue with categories, events and multilingual content.",
	"keywords": [ "newsletter", "issues", "events" ],
	"textdomain": "newsletter-wp-plugin",
	"attributes": {
		"issueId": {
			"type": "number",
			"default": 0
		},
		"language": {
			"type": "string",
			"default": ""
		},
		"displayMode": {
			"type": "string",
			"default": ""
		},
		"showTitle": {
			"type": "boolean"
		},
		"showIntro": {
			"type": "boolean"
		}
	},
	"supports": {
		"html": false,
		"align": [ "wide", "full" ]
	}
}
