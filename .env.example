# Copy this file to .env to override the local Docker defaults.

# Host port for the WordPress test site.
WP_PORT=8090

# Initial WordPress site details. These are used only on the first install.
WP_TITLE=Newsletter Publisher Test
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=adminpass
WP_ADMIN_EMAIL=admin@example.test

# Local database credentials.
MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=wordpress
MYSQL_ROOT_PASSWORD=root
